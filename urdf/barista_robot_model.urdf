<?xml version="1.0"?>
<robot name="barista_robot">
	
  <material name="blue">
      <color rgba="0.0 0.0 1.0 1"/>
  </material>

  <material name="yellow">
      <color rgba="1.0 1.0 0.0 1"/>
  </material>

  <material name="red">
      <color rgba="1.0 0.0 0.0 1"/>
  </material>

  <material name="green_dark">
    <color rgba="0.0 0.5 0.0 1"/>
  </material>

  <link name="base_link">
	</link>

<!-- Body -->
	<link name="chassis">
		<visual>
		<origin rpy="0 0 0" xyz="0 0 0" />
			<geometry>
				<cylinder length="0.155" radius="0.178"/>
			</geometry>
			<material name="blue"/>
		</visual>

    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.155" radius="0.178"/>
      </geometry>
    </collision>

    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.019846166666666665" ixy="0" ixz="0" iyy="0.019846166666666665" iyz="0" izz="0.031684"/>
    </inertial>
	</link>

	<joint name="base_link_to_chassis_joint" type="fixed">
		<origin xyz="0 0 0.0" rpy="0 0 0"/>
		<parent link="base_link"/>
		<child link="chassis"/>
	</joint>

<!-- Standoff rods -->
	<link name="rod_front_left">
		<visual>
		<origin rpy="0 0 0" xyz="0 0 0" />
			<geometry>
				<cylinder length="0.220" radius="0.01"/>
			</geometry>
			<material name="yellow"/>
		</visual>

    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.220" radius="0.01"/>
      </geometry>
    </collision>

    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.00040583333333333335" ixy="0" ixz="0" iyy="0.00040583333333333335" iyz="0" izz="5e-06"/>
    </inertial>
	</link>

	<joint name="chassis_to_rod_front_left_joint" type="fixed">
		<origin xyz="0.089 0.089 0.1875" rpy="0 0 0"/>
		<parent link="chassis"/>
		<child link="rod_front_left"/>
	</joint>

	<link name="rod_front_right">
		<visual>
		<origin rpy="0 0 0" xyz="0 0 0" />
			<geometry>
				<cylinder length="0.220" radius="0.01"/>
			</geometry>
			<material name="yellow"/>
		</visual>

    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.220" radius="0.01"/>
      </geometry>
    </collision>

    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.00040583333333333335" ixy="0" ixz="0" iyy="0.00040583333333333335" iyz="0" izz="5e-06"/>
    </inertial>
	</link>

	<joint name="chassis_to_rod_front_right_joint" type="fixed">
		<origin xyz="0.089 -0.089 0.1875" rpy="0 0 0"/>
		<parent link="chassis"/>
		<child link="rod_front_right"/>
	</joint>

	<link name="rod_back_left">
		<visual>
		<origin rpy="0 0 0" xyz="0 0 0" />
			<geometry>
				<cylinder length="0.220" radius="0.01"/>
			</geometry>
			<material name="red"/>
		</visual>

    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.220" radius="0.01"/>
      </geometry>
    </collision>

    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.00040583333333333335" ixy="0" ixz="0" iyy="0.00040583333333333335" iyz="0" izz="5e-06"/>
    </inertial>
	</link>

	<joint name="chassis_to_rod_back_left_joint" type="fixed">
		<origin xyz="-0.089 0.089 0.1875" rpy="0 0 0"/>
		<parent link="chassis"/>
		<child link="rod_back_left"/>
	</joint>

	<link name="rod_back_right">
		<visual>
		<origin rpy="0 0 0" xyz="0 0 0" />
			<geometry>
				<cylinder length="0.220" radius="0.01"/>
			</geometry>
			<material name="red"/>
		</visual>

    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.220" radius="0.01"/>
      </geometry>
    </collision>

    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.00040583333333333335" ixy="0" ixz="0" iyy="0.00040583333333333335" iyz="0" izz="5e-06"/>
    </inertial>
	</link>

	<joint name="chassis_to_rod_back_right_joint" type="fixed">
		<origin xyz="-0.089 -0.089 0.1875" rpy="0 0 0"/>
		<parent link="chassis"/>
		<child link="rod_back_right"/>
	</joint>

<!-- Cup holder tray -->
	<link name="cup_holder_tray">
		<visual>
		<origin rpy="0 0 0" xyz="0 0 0" />
			<geometry>
				<cylinder length="0.090" radius="0.160"/>
			</geometry>
			<material name="blue"/>
		</visual>

    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.090" radius="0.160"/>
      </geometry>
    </collision>

    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.007075" ixy="0" ixz="0" iyy="0.007075" iyz="0" izz="0.0128"/>
    </inertial>
	</link>


	<joint name="chassis_to_cup_holder_tray_joint" type="fixed">
		<origin xyz="0 0 0.3425" rpy="0 0 0"/>
		<parent link="chassis"/>
		<child link="cup_holder_tray"/>
	</joint>

<!-- Drive wheels -->
	<link name="left_wheel">
		<visual>
		<origin rpy="1.5708 0 0" xyz="0 0 0" />
			<geometry>
				<cylinder length="0.0206" radius="0.0352"/>
			</geometry>
			<material name="green_dark"/>
		</visual>

    <collision>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.0206" radius="0.0352"/>
      </geometry>
    </collision>

    <inertial>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="6.902466666666668e-05" ixy="0" ixz="0" iyy="6.902466666666668e-05" iyz="0" izz="0.000123904"/>
    </inertial>
	</link>

	<joint name="left_wheel_joint" type="continuous">
		<origin xyz="0 0.1883 -0.0775" rpy="0 0 0"/>
		<parent link="chassis"/>
		<child link="left_wheel"/>
    <axis rpy="0 0 0" xyz="0 1 0"/>
    <limit effort="10000" velocity="1000"/>
    <joint_properties damping="1.0" friction="1.0"/>
	</joint>

	<link name="right_wheel">
		<visual>
		<origin rpy="1.5708 0 0" xyz="0 0 0" />
			<geometry>
				<cylinder length="0.0206" radius="0.0352"/>
			</geometry>
			<material name="green_dark"/>
		</visual>

    <collision>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.0206" radius="0.0352"/>
      </geometry>
    </collision>

    <inertial>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="6.902466666666668e-05" ixy="0" ixz="0" iyy="6.902466666666668e-05" iyz="0" izz="0.000123904"/>
    </inertial>
	</link>

	<joint name="right_wheel_joint" type="continuous">
		<origin xyz="0 -0.1883 -0.0775" rpy="0 0 0"/>
		<parent link="chassis"/>
		<child link="right_wheel"/>
    <axis rpy="0 0 0" xyz="0 1 0"/>
    <limit effort="10000" velocity="1000"/>
    <joint_properties damping="1.0" friction="1.0"/>
	</joint>

<!-- Front Caster Wheel -->
	<link name="front_yaw_link">
		<visual>
		<origin rpy="0 0 0" xyz="0 0 0" />
			<geometry>
				<cylinder length="0.001" radius="0.0045000000000000005"/>
			</geometry>
			<material name="blue"/>
		</visual>

		<collision>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<geometry>
				<cylinder length="0.001" radius="0.0045000000000000005"/>
			</geometry>
		</collision>

		<inertial>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<mass value="0.001"/>
			<inertia ixx="5.145833333333334e-09" ixy="0" ixz="0" iyy="5.145833333333334e-09" iyz="0" izz="1.0125000000000003e-08"/>
		</inertial>
	</link>

	<joint name="front_yaw_joint" type="continuous">
		<origin xyz="0.1335 0 -0.0775" rpy="0 0 0"/>
		<parent link="chassis"/>
		<child link="front_yaw_link"/>
		<axis xyz="0 0 1"/>
	</joint>

	<link name="front_roll_link">
		<visual>
		<origin rpy="0 0 0" xyz="0 0 0" />
			<geometry>
				<cylinder length="0.001" radius="0.0045000000000000005"/>
			</geometry>
			<material name="red"/>
		</visual>

		<collision>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<geometry>
				<cylinder length="0.001" radius="0.0045000000000000005"/>
			</geometry>
		</collision>

		<inertial>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<mass value="0.001"/>
			<inertia ixx="5.145833333333334e-09" ixy="0" ixz="0" iyy="5.145833333333334e-09" iyz="0" izz="1.0125000000000003e-08"/>		
		</inertial>
	</link>

	<joint name="front_roll_joint" type="continuous">
		<origin xyz="0 0 0" rpy="0 0 0"/>
		<parent link="front_yaw_link"/>
		<child link="front_roll_link"/>
		<axis xyz="1 0 0"/>
	</joint>

	<link name="front_pitch_link">
		<visual>
		<origin rpy="0 0 0" xyz="0 0 0" />
			<geometry>
				<sphere radius="0.0352"/>
			</geometry>
			<material name="green_dark"/>
		</visual>

		<collision>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<geometry>
				<sphere radius="0.0352"/>
			</geometry>
		</collision>

		<inertial>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<mass value="0.05"/>
			<inertia ixx="2.47808e-05" ixy="0" ixz="0" iyy="2.47808e-05" iyz="0" izz="2.47808e-05"/>
		</inertial>
	</link>

	<joint name="front_pitch_joint" type="continuous">
		<origin xyz="0 0 0" rpy="0 0 0"/>
		<parent link="front_roll_link"/>
		<child link="front_pitch_link"/>
	  <axis xyz="0 1 0"/>
	</joint>

<!-- Back Caster Wheel -->
	<link name="back_yaw_link">
		<visual>
		<origin rpy="0 0 0" xyz="0 0 0" />
			<geometry>
				<cylinder length="0.001" radius="0.0045000000000000005"/>
			</geometry>
			<material name="blue"/>
		</visual>

		<collision>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<geometry>
				<cylinder length="0.001" radius="0.0045000000000000005"/>
			</geometry>
		</collision>

		<inertial>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<mass value="0.001"/>
			<inertia ixx="5.145833333333334e-09" ixy="0" ixz="0" iyy="5.145833333333334e-09" iyz="0" izz="1.0125000000000003e-08"/>
		</inertial>
	</link>

	<joint name="back_yaw_joint" type="continuous">
		<origin xyz="-0.1335 0 -0.0775" rpy="0 0 0"/>
		<parent link="chassis"/>
		<child link="back_yaw_link"/>
		<axis xyz="0 0 1"/>
	</joint>

	<link name="back_roll_link">
		<visual>
		<origin rpy="0 0 0" xyz="0 0 0" />
			<geometry>
				<cylinder length="0.001" radius="0.0045000000000000005"/>
			</geometry>
			<material name="red"/>
		</visual>

		<collision>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<geometry>
				<cylinder length="0.001" radius="0.0045000000000000005"/>
			</geometry>
		</collision>

		<inertial>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<mass value="0.001"/>
			<inertia ixx="5.145833333333334e-09" ixy="0" ixz="0" iyy="5.145833333333334e-09" iyz="0" izz="1.0125000000000003e-08"/>		
		</inertial>
	</link>

	<joint name="back_roll_joint" type="continuous">
		<origin xyz="0 0 0" rpy="0 0 0"/>
		<parent link="back_yaw_link"/>
		<child link="back_roll_link"/>
		<axis xyz="1 0 0"/>
	</joint>

	<link name="back_pitch_link">
		<visual>
		<origin rpy="0 0 0" xyz="0 0 0" />
			<geometry>
				<sphere radius="0.0352"/>
			</geometry>
			<material name="green_dark"/>
		</visual>

		<collision>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<geometry>
				<sphere radius="0.0352"/>
			</geometry>
		</collision>

		<inertial>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<mass value="0.05"/>
			<inertia ixx="2.47808e-05" ixy="0" ixz="0" iyy="2.47808e-05" iyz="0" izz="2.47808e-05"/>
		</inertial>
	</link>

	<joint name="back_pitch_joint" type="continuous">
		<origin xyz="0 0 0" rpy="0 0 0"/>
		<parent link="back_roll_link"/>
		<child link="back_pitch_link"/>
	  <axis xyz="0 1 0"/>
	</joint>

<!-- Laser scanner -->
  <link name="laser_scan_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://barista_robot_description/meshes/slamtec_rplidar_s1.dae" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>

    <collision>
       <origin rpy="0 0 0" xyz="0 0 0.0204"/>
      <geometry>
        <cylinder length="0.051" radius="0.027745"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.01"/>
      <origin rpy="0 0 0" xyz="0 0 0.0255"/>
      <inertia ixx="4.0919625625e-06" ixy="0" ixz="0" iyy="4.0919625625e-06" iyz="0" izz="3.848925125e-06"/>
    </inertial>
  </link>

  <joint name="laser_scan_link_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.1335 0.0 0.0775"/>
    <parent link="chassis"/>
    <child link="laser_scan_link"/>
  </joint>

<!-- PLUGINS -->
<!-- Joint State Publisher Plugin -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
        <topic>/joint_states</topic>
        <update_rate>30</update_rate>
        <!-- Publish the state of these joints -->
        <joint_name>left_wheel_joint</joint_name>
        <joint_name>right_wheel_joint</joint_name>
        <joint_name>front_yaw_joint</joint_name>
        <joint_name>back_yaw_joint</joint_name>
        <joint_name>front_roll_joint</joint_name>
        <joint_name>back_roll_joint</joint_name>
        <joint_name>front_pitch_joint</joint_name>
        <joint_name>back_pitch_joint</joint_name>
    </plugin>
  </gazebo>  

<!-- Differential Drive Plugin -->
  <gazebo>
    <plugin
        filename="gz-sim-diff-drive-system"
        name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.3766</wheel_separation>
        <wheel_radius>0.0352</wheel_radius>
        <topic>cmd_vel</topic>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <publish_wheel_tf>true</publish_wheel_tf>
        <odom_topic>odom</odom_topic>
        <tf_topic>tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
    </plugin>
  </gazebo>
  
</robot>