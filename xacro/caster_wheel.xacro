<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Properties -->
  <xacro:property name="caster_axis_radius" value="0.0045"/>
  <xacro:property name="caster_axis_length" value="0.001"/>
  <xacro:property name="caster_ball_radius" value="0.0352"/>

  <material name="red">
      <color rgba="1.0 0.0 0.0 1"/>
  </material>

  <xacro:macro name="caster_wheel" params="prefix_link_name">
    <link name="${prefix_link_name}_yaw_link">
      <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <cylinder length="${caster_axis_radius}" radius="${caster_axis_radius}"/>
        </geometry>
        <material name="blue"/>
      </visual>

      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <cylinder length="${caster_axis_radius}" radius="${caster_axis_radius}"/>
        </geometry>
      </collision>

      <inertial>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <mass value="0.001"/>
        <inertia ixx="5.145833333333334e-09" ixy="0" ixz="0" iyy="5.145833333333334e-09" iyz="0" izz="1.0125000000000003e-08"/>
      </inertial>
    </link>

    <link name="${prefix_link_name}_roll_link">
      <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <cylinder length="${caster_axis_radius}" radius="${caster_axis_radius}"/>
        </geometry>
        <material name="red"/>
      </visual>

      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <cylinder length="${caster_axis_radius}" radius="${caster_axis_radius}"/>
        </geometry>
      </collision>

      <inertial>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <mass value="0.001"/>
        <inertia ixx="5.145833333333334e-09" ixy="0" ixz="0" iyy="5.145833333333334e-09" iyz="0" izz="1.0125000000000003e-08"/>		
      </inertial>
    </link>

    <link name="${prefix_link_name}_pitch_link">
      <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <sphere radius="${caster_ball_radius}"/>
        </geometry>
        <material name="green_dark"/>
      </visual>

      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <sphere radius="0.0352"/>
        </geometry>
      </collision>

      <inertial>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="2.47808e-05" ixy="0" ixz="0" iyy="2.47808e-05" iyz="0" izz="2.47808e-05"/>
      </inertial>
    </link>
  </xacro:macro>
</robot>