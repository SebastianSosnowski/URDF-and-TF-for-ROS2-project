<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
<!-- Properties -->
  <xacro:property name="wheel_radius" value="0.0352"/>
  <xacro:property name="wheel_width" value="0.0206"/>

  <material name="green_dark">
    <color rgba="0.0 0.5 0.0 1"/>
  </material>

  <xacro:macro name="drive_wheel" params="wheel_link_name">
    <link name="${wheel_link_name}">
      <visual>
      <origin rpy="1.5708 0 0" xyz="0 0 0" />
        <geometry>
          <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
        </geometry>
        <material name="green_dark"/>
      </visual>

      <collision>
        <origin rpy="1.5708 0 0" xyz="0 0 0"/>
        <geometry>
          <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
        </geometry>
      </collision>

      <inertial>
        <origin rpy="1.5708 0 0" xyz="0 0 0"/>
        <mass value="0.2"/>
        <inertia ixx="6.902466666666668e-05" ixy="0" ixz="0" iyy="6.902466666666668e-05" iyz="0" izz="0.000123904"/>
      </inertial>
    </link>
  </xacro:macro>
</robot>