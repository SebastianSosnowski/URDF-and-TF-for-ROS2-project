<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="barista_robot">

<!-- Properties -->
  <xacro:property name="body_lenght" value="0.155"/>
  <xacro:property name="body_radius" value="0.178"/>

  <material name="blue">
      <color rgba="0.0 0.0 1.0 1"/>
  </material>

  <link name="base_link">
	</link>

<!-- Body -->
	<link name="chassis">
		<visual>
		<origin rpy="0 0 0" xyz="0 0 0" />
			<geometry>
				<cylinder length="${body_lenght}" radius="${body_radius}"/>
			</geometry>
			<material name="blue"/>
		</visual>

    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="${body_lenght}" radius="${body_radius}"/>
      </geometry>
    </collision>

    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.019846166666666665" ixy="0" ixz="0" iyy="0.019846166666666665" iyz="0" izz="0.031684"/>
    </inertial>
	</link>

	<joint name="base_link_to_chassis_joint" type="fixed">
		<origin xyz="0 0 0.0" rpy="0 0 0"/>
		<parent link="base_link"/>
		<child link="chassis"/>
	</joint>

</robot>