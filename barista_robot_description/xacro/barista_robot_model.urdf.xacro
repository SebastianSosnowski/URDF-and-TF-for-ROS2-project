<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="barista_bot_$(arg robot_name)">
  <xacro:arg name="robot_name" default="barista_bot"/>
  <xacro:arg name="include_laser" default="true"/>
  <xacro:arg name="body_color" default="0.0 0.0 1.0 1.0"/>

  <xacro:include filename="$(find barista_robot_description)/xacro/drive_wheel.xacro"/>
  <xacro:include filename="$(find barista_robot_description)/xacro/caster_wheel.xacro"/>
  <xacro:include filename="$(find barista_robot_description)/xacro/standoff_rod.xacro"/>
  <xacro:include filename="$(find barista_robot_description)/xacro/cup_holder_tray.xacro"/>
  <xacro:include filename="$(find barista_robot_description)/xacro/laser_scanner.xacro"/>

<!-- Properties -->
  <xacro:property name="include_laser" value="$(arg include_laser)"/>
  <xacro:property name="robot_name" value="$(arg robot_name)"/>
  <xacro:property name="body_color" value="$(arg body_color)"/>

  <xacro:property name="body_length" value="0.155"/>
  <xacro:property name="body_radius" value="0.178"/>


<material name="blue">
    <color rgba="0.0 0.0 1.0 1.0"/>
</material>

<material name="robot_body_material">
    <color rgba="${body_color}"/>
</material>

  <link name="base_link">
	</link>

<!-- Body -->
	<link name="chassis">
		<visual>
		<origin rpy="0 0 0" xyz="0 0 0" />
			<geometry>
				<cylinder length="${body_length}" radius="${body_radius}"/>
			</geometry>
			<material name="robot_body_material"/>
		</visual>

    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="${body_length}" radius="${body_radius}"/>
      </geometry>
    </collision>

    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.019846166666666665" ixy="0" ixz="0" iyy="0.019846166666666665" iyz="0" izz="0.031684"/>
    </inertial>
	</link>

	<joint name="base_link_to_chassis_joint" type="fixed">
		<origin xyz="0 0 0.0" rpy="0 0 0"/>
		<parent link="base_link"/>
		<child link="chassis"/>
	</joint>

<!-- Wheel Left -->
  <xacro:drive_wheel wheel_link_name="left_wheel" />

	<joint name="left_wheel_joint" type="continuous">
    <origin xyz="0 0.1335 -0.0775" rpy="0 0 0"/>
		<parent link="chassis"/>
		<child link="left_wheel"/>
    <axis rpy="0 0 0" xyz="0 1 0"/>
    <limit effort="10000" velocity="1000"/>
    <joint_properties damping="1.0" friction="1.0"/>
	</joint>

<!-- Wheel Right -->
  <xacro:drive_wheel wheel_link_name="right_wheel"/>

	<joint name="right_wheel_joint" type="continuous">
		<origin xyz="0 -0.1335 -0.0775" rpy="0 0 0"/>
		<parent link="chassis"/>
		<child link="right_wheel"/>
    <axis rpy="0 0 0" xyz="0 1 0"/>
    <limit effort="10000" velocity="1000"/>
    <joint_properties damping="1.0" friction="1.0"/>
	</joint>

<!-- Front Caster Wheel -->
  <xacro:caster_wheel prefix_link_name="front"/>

	<joint name="front_yaw_joint" type="continuous">
		<origin xyz="0.1335 0 -0.0775" rpy="0 0 0"/>
		<parent link="chassis"/>
		<child link="front_yaw_link"/>
		<axis xyz="0 0 1"/>
	</joint>

	<joint name="front_roll_joint" type="continuous">
		<origin xyz="0 0 0" rpy="0 0 0"/>
		<parent link="front_yaw_link"/>
		<child link="front_roll_link"/>
		<axis xyz="1 0 0"/>
	</joint>

	<joint name="front_pitch_joint" type="continuous">
		<origin xyz="0 0 0" rpy="0 0 0"/>
		<parent link="front_roll_link"/>
		<child link="front_pitch_link"/>
	  <axis xyz="0 1 0"/>
    <dynamics damping="1.0" friction="1.0"/>
	</joint>

<!-- Back Caster Wheel -->
  <xacro:caster_wheel prefix_link_name="back"/>

	<joint name="back_yaw_joint" type="continuous">
		<origin xyz="-0.1335 0 -0.0775" rpy="0 0 0"/>
		<parent link="chassis"/>
		<child link="back_yaw_link"/>
		<axis xyz="0 0 1"/>
	</joint>

	<joint name="back_roll_joint" type="continuous">
		<origin xyz="0 0 0" rpy="0 0 0"/>
		<parent link="back_yaw_link"/>
		<child link="back_roll_link"/>
		<axis xyz="1 0 0"/>
	</joint>

	<joint name="back_pitch_joint" type="continuous">
		<origin xyz="0 0 0" rpy="0 0 0"/>
		<parent link="back_roll_link"/>
		<child link="back_pitch_link"/>
	  <axis xyz="0 1 0"/>
    <dynamics damping="1.0" friction="1.0"/>
	</joint>

<!-- Standoff rods -->
  <xacro:standoff_rod rod_link_name="rod_front_left"/>
	
  <joint name="rod_front_left_joint" type="fixed">
		<origin xyz="0.089 0.089 0.1875" rpy="0 0 0"/>
		<parent link="chassis"/>
		<child link="rod_front_left"/>
	</joint>

  <xacro:standoff_rod rod_link_name="rod_front_right"/>
	
	<joint name="rod_front_right_joint" type="fixed">
		<origin xyz="0.089 -0.089 0.1875" rpy="0 0 0"/>
		<parent link="chassis"/>
		<child link="rod_front_right"/>
	</joint>

  <xacro:standoff_rod rod_link_name="rod_back_left"/>

	<joint name="rod_back_left_joint" type="fixed">
		<origin xyz="-0.089 0.089 0.1875" rpy="0 0 0"/>
		<parent link="chassis"/>
		<child link="rod_back_left"/>
	</joint>

  <xacro:standoff_rod rod_link_name="rod_back_right"/>

	<joint name="rod_back_right_joint" type="fixed">
		<origin xyz="-0.089 -0.089 0.1875" rpy="0 0 0"/>
		<parent link="chassis"/>
		<child link="rod_back_right"/>
	</joint>

<!-- Cup holder tray -->
  <xacro:cup_holder_tray link_name="cup_holder_tray"/>

	<joint name="cup_holder_tray_joint" type="fixed">
		<origin xyz="0 0 0.3425" rpy="0 0 0"/>
		<parent link="chassis"/>
		<child link="cup_holder_tray"/>
	</joint>

<!-- Laser scanner -->
<xacro:if value="${include_laser}">
  <xacro:laser_scanner link_name="laser_scan_link"/>

  <joint name="laser_scan_link_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.1335 0.0 0.0775"/>
    <parent link="chassis"/>
    <child link="laser_scan_link"/>
  </joint>
</xacro:if>

<!-- PLUGINS -->
<!-- Joint State Publisher Plugin -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
        <topic>${robot_name}/joint_states</topic>
        <update_rate>30</update_rate>
        <!-- Publish the state of these joints -->
        <joint_name>left_wheel_joint</joint_name>
        <joint_name>right_wheel_joint</joint_name>
        <joint_name>front_yaw_joint</joint_name>
        <joint_name>back_yaw_joint</joint_name>
        <joint_name>front_roll_joint</joint_name>
        <joint_name>back_roll_joint</joint_name>
        <joint_name>front_pitch_joint</joint_name>
        <joint_name>back_pitch_joint</joint_name>
    </plugin>
  </gazebo>  

<!-- Differential Drive Plugin -->
  <gazebo>
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.267</wheel_separation>
      <wheel_radius>0.0352</wheel_radius>
      <topic>${robot_name}/cmd_vel</topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odom_topic>${robot_name}/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>${robot_name}/odom</frame_id>
      <child_frame_id>${robot_name}/base_link</child_frame_id>
    </plugin>
  </gazebo>

  <xacro:if value="${include_laser}">
  <!-- Laser Scanner Plugin -->
    <gazebo reference="laser_scan_link">
      <sensor type="gpu_lidar" name="gpu_lidar">
        <pose relative_to='laser_scan_link'>0 0 0 0 0 0</pose>
        <gz_frame_id>${robot_name}/laser_scan_link</gz_frame_id>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <update_rate>100</update_rate>
        <topic>${robot_name}/scan</topic>
        <ray>
          <scan>
            <horizontal>
              <samples>200</samples>
              <resolution>1</resolution>
              <min_angle>-1.57</min_angle>
              <max_angle>1.57</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.1</min>
            <max>5.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
      </sensor>
    </gazebo>
  </xacro:if>

</robot>