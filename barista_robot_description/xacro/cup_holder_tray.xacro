<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Properties -->
  <xacro:property name="tray_length" value="0.090"/>
  <xacro:property name="tray_radius" value="0.160"/>

  <xacro:macro name="cup_holder_tray" params="link_name">
	<link name="${link_name}">
		<visual>
		<origin rpy="0 0 0" xyz="0 0 0" />
			<geometry>
				<cylinder length="${tray_length}" radius="${tray_radius}"/>
			</geometry>
			<material name="robot_body_material"/>
		</visual>

    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="${tray_length}" radius="${tray_radius}"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00008117" ixy="0" ixz="0" iyy="0.00008117" iyz="0" izz="0.000001"/>
    </inertial>
	</link>
  </xacro:macro>
</robot>