<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:property name="wheel_width" value="0.0206"/>
<xacro:property name="wheel_radius" value="0.0352"/>

<xacro:macro name="caster_wheel" params="wheel_name">

    <link name="${wheel_name}">
        <visual>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
            </geometry>
            <material name="blue"/>
        </visual>

        <inertial>
            <mass value="0.01"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.0000031184" ixy="0" ixz="0" iyy="0.0000031184" iyz="0" izz="0.000006195"/>
        </inertial>

        <collision>
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <geometry>
                <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
            </geometry>
        </collision>
    </link>

    <gazebo reference="${wheel_name}">
        <collision>
            <surface>
            <friction>
                <ode>
                <mu>0.1</mu>
                <mu2>0.1</mu2>
                </ode>
            </friction>
            <contact>
                <ode>
                <kp>1000000000000000000000000000.0</kp>
                <kd>1000000000000000000000000000.0</kd>
                </ode>
            </contact>
            </surface>
        </collision>
    </gazebo>

</xacro:macro>
    
</robot>   